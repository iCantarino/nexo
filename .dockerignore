nexo-api/.env
nexo-ui/.env

# Build local
nexo-ui/dist/

# Git
.git/
.gitignore

# Logs
*.log
npm-debug.log*

# Testes
coverage/
test-results/
playwright-report/
.playwright/
nexo-api/test-results/

# Sistema
.DS_Store
Thumbs.db