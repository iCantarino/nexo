# =====================================================================
# Dockerfile — Nexo UI (React + Vite + Nginx)
# Modo: Produção (build estático servido por Nginx)
# =====================================================================

# ---- Estágio 1: Build ----
FROM node:22-alpine AS builder

WORKDIR /app

# URL base da API (usada pelo axios no frontend)
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL

# Instala dependências
COPY nexo-ui/package*.json ./
RUN npm ci

# Copia o código e faz o build
COPY nexo-ui .
RUN npm run build

# ---- Estágio 2: Servir com Nginx ----
FROM nginx:alpine

# Configuração do nginx com proxy reverso para a API
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Artefatos do build
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]