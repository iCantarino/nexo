{
  "name": "nexo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend do e-commerce de livros Nexo (Node.js + Express + Sequelize + MySQL).",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "setup-db": "node scripts/setupDb.js",
    "migrate:cupons-pix": "node scripts/migrarCuponsPix.js",
    "migrate:vendas": "node scripts/migrarVendas.js",
    "migrate": "node scripts/migrar.js",
    "seed:analise": "node scripts/seedAnalise.js",
    "ia:treinar": "node scripts/treinarModeloIA.js",
    "test": "node --test tests/unit/*.test.js",
    "test:functional": "playwright test",
    "test:analise-ui": "playwright test -c playwright-analise-ui.config.js",
    "test:compra-ui": "playwright test -c playwright-compra-ui.config.js",
    "test:vendas-ui": "playwright test -c playwright-vendas-ui.config.js",
    "test:selenium": "node --test --test-concurrency=1 --test-timeout=240000 tests/selenium/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "mysql2": "^3.11.4",
    "sequelize": "^6.37.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "nodemon": "^3.1.7",
    "selenium-webdriver": "^4.51.0"
  }
}
