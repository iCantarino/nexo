# ==========================================================
# NEXO API — Exemplo de Variáveis de Ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# ==========================================================

# --- Banco de Dados (MySQL 8+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=nexo_db

# --- Segurança / JWT ---
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1h

# --- Aplicação ---
NODE_ENV=development
APP_PORT=8000

# --- CORS (origens do front-end nexo-ui) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Carrinho (RN0044 / RNF0045): prazo do bloqueio dos itens, em minutos ---
CART_LOCK_MINUTES=15

# --- IA Generativa (RNF0044) ---
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

