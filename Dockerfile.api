# =====================================================================
# Dockerfile — Nexo API (Express + Sequelize + MySQL)
# =====================================================================
FROM node:22-alpine

WORKDIR /app

# Copia apenas os arquivos de dependência primeiro (cache otimizado)
COPY nexo-api/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

# Copia o código fonte e scripts
COPY nexo-api/src ./src
COPY nexo-api/scripts ./scripts

# Railway injeta a variável PORT; usamos ela como fallback para APP_PORT
EXPOSE 8000
CMD ["sh", "-c", "APP_PORT=${PORT:-8000} node src/server.js"]