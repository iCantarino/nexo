# =====================================================================
# Nexo — Variáveis de Ambiente para Docker
# Copie este arquivo como .env e ajuste os valores.
# =====================================================================

# ─── MySQL ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=nexo_root_pass
DB_USER=root
DB_PASSWORD=nexo_root_pass
DB_NAME=nexo_db
DB_HOST=mysql
DB_PORT=3306

# ─── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=1h

# ─── Aplicação ─────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=8000
UI_PORT=80

# ─── CORS (origens permitidas) ────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1

# ─── Frontend (URL base da API para o build do Vite) ──────────────
# Em produção com Nginx: /api/v1 (proxy reverso cuida do roteamento)
VITE_API_URL=/api/v1